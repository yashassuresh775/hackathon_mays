# Copy to terraform.tfvars and set values. terraform.tfvars is gitignored.
# Use the same region as your existing S3 buckets (e.g. us-west-2).
# Check: aws s3api get-bucket-location --bucket interview-ai-packets-hackathon-<ACCOUNT_ID>

aws_region = "us-west-2"

# Optional overrides:
# project_name = "interview-ai"
# environment   = "hackathon"

# Optional: external ingest — set to enable web data for Kendra (DuckDuckGo runs with no key)
# google_cse_api_key = ""
# google_cse_cx      = ""
# bing_subscription_key = ""   # Azure Bing Web Search v7
# news_api_key       = ""
