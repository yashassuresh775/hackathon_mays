# AWS credentials (Option 2: environment variables)
# Set these before running Terraform or the AWS CLI.
# Get keys from: IAM → Users → Your user → Security credentials → Create access key

export AWS_ACCESS_KEY_ID="AKIA..."
export AWS_SECRET_ACCESS_KEY="..."
export AWS_DEFAULT_REGION="us-east-1"

# Optional: use a named profile instead
# export AWS_PROFILE=hackathon
